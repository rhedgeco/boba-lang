// imports are const assignments that call the `import()` function
const std = import().std();

// a braced scope is anything surrounded by curly braces
// named sub-scopes are const assignments that assign a braced scope
// in this case, the named sub-scope can only contain other const assignments
// because all of the contents have to be able to be resolved in a const context
const sub_scope = {
    // structs are const assignments that call the `struct()` function
    // the build function takes a braced scope that defines the fields
    // these are just const assignments that evaluate to a type
    pub const Hello = struct().build({
        // any fields that are public can be accessed with the . operator
        // if all the fields are public, then the struct can be created without an explicit constructor
        pub const name = std:str;
    });

    // functions are const assignments that call the `func()` function
    pub const print_hello = func()
        // inputs can be added by chaining the `input(...)` function
        // these are just more const assignments that evaluate to a type
        .input({
            pub const hello = Hello;
        })
        // the body of the function is defined in the `build(...)` function
        // the build function accepts another braced scope just like the ones above
        // however, this scope can contain inline expressions that will be executed in order at runtime
        .build({
            std:print("Hello, ");
            std:print(hello.name);
            std:print("!");
        });
};

// even the main function is just another const assignment function
pub const main = func().build({
    // let assignments are used for runtime assignments
    // since all the fields are public on Hello
    // it can just be constructed like this
    let hello = sub_scope:Hello("Ryan");

    // and then the print function from sub_scope can be called with the struct
    sub_scope:print_hello(hello);
});
